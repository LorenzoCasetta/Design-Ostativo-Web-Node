{
  "manifest_version": 3,
  "name": "Web Node",
  "version": "4.1.5",
  "minimum_chrome_version": "116",
  "description": "un navigatore per orientarsi nei siti web",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "Web Node",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "version_name": "4.1.5"
}
